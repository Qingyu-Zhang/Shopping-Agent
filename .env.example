# Local defaults run demo catalog, platform and worker inside the API process.
DEMO=1
EMBEDDED_WORKER=1
CHECKOUT_ENABLED=1
AUTOBUY_ENABLED=0

# Optional model provider. Use the compatible base URL including /v1.
MODEL_URL=
MODEL_KEY=
CHAT_MODEL=
EMBEDDING_URL=
EMBEDDING_KEY=
EMBEDDING_MODEL=
RERANK_URL=
RERANK_KEY=
RERANK_MODEL=
CLIP_MODEL=
CATALOG_IMAGES=
VISION_CHAT_MODEL=
REVIEW_RECALL=1
INSTALL_VISION=0

# Optional external services.
# DATABASE=postgresql://shopping:shopping@localhost:5432/agent
# PLATFORM_DATABASE=postgresql://shopping:shopping@localhost:5432/platform
# CATALOG_DATABASE=postgresql://reader:password@localhost:5432/platform
# ELASTIC_URL=http://localhost:9200
# REDIS_URL=redis://localhost:6379/0
# PLATFORM_URL=http://localhost:8001/mcp
# PLATFORM_TRANSPORT=mcp
# PLATFORM_TOKEN=local-platform-token

# Required when DEMO=0.
AUTH_JWT_SECRET=
AUTH_ISSUER=shopping-identity
AUTH_AUDIENCE=shopping-agent
